{
  "name": "ne-yersin-mobil",
  "version": "1.0.0",
  "private": true,
  "description": "Ne Yersin? — iOS/Android uygulamaları (müşteri + kurye)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "musteri": "npm run start --workspace musteri",
    "kurye": "npm run start --workspace kurye",
    "kurye:guncelle": "npm run guncelle --workspace kurye --",
    "kurye:derle": "npm run derle --workspace kurye",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
