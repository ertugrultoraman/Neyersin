# dependencies
node_modules/
.pnp
.pnp.*

# next.js
/.next/
# Yerel derleme çıktısı (bkz. next.config.ts → distDir); OneDrive kilitlemesin diye ayrı.
# Yıldız BİLEREK: ikinci bir sunucu (ör. mobil API testi için ayrı porttaki
# `next dev`) aynı dizine yazarsa Windows dosyayı kilitliyor ve iki taraf da
# "EBUSY / Internal Server Error" veriyor. O sunucu NEXT_DIST_DIR ile kendi
# dizinini alıyor; hepsi bu kalıba giriyor.
/.next-yerel*/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# env — ASLA commit edilmez (API anahtarları, blob token)
.env
.env.*
!.env.example

# vercel
.vercel

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
.vscode/*
!.vscode/extensions.json

# geçici görsel çıktıları (manifest commit edilir, ara dosyalar edilmez)
/.image-cache/

# yerel "next start" günlükleri — makineye özel, commit edilmez
/.next-start.log
/.next-start.log.err

# yerel sipariş ve hesap deposu — kişisel veri + parola özeti içerir, ASLA commit edilmez
/.veri/
/.veri-*/

