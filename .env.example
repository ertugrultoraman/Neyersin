# ---------------------------------------------------------------------------
# Ne Yersin? — ortam değişkenleri
# Lokal: bu dosyayı `.env.local` olarak kopyala ve doldur.
# Vercel: Project Settings → Environment Variables (Production/Preview/Development)
# Hiçbiri NEXT_PUBLIC_ değil — tamamı yalnızca sunucu tarafında kullanılır.
# ---------------------------------------------------------------------------

# Sitenin kanonik adresi (sitemap, robots, OG etiketleri için).
# Vercel'de otomatik gelen VERCEL_PROJECT_PRODUCTION_URL fallback olarak kullanılır.
NEXT_PUBLIC_SITE_URL=https://neyersin.com

# --- Sipariş ve başvuru kaydı ----------------------------------------------
# Oluşan sipariş bu adrese POST edilir (n8n / Zapier / Apps Script / kendi API'niz).
# Tanımlı değilse sipariş yalnızca sunucu günlüğüne yazılır (Vercel → Logs).
# NOT: Kalıcı bir veritabanı yerine geçmez — bkz. README "Siparişler nereye kaydediliyor?"
SIPARIS_WEBHOOK_URL=

# İletişim/başvuru formu hedefi. Boşsa SIPARIS_WEBHOOK_URL kullanılır.
BASVURU_WEBHOOK_URL=

# --- Sipariş veritabanı ----------------------------------------------------
# TANIMLIYSA: siparişler Postgres'e yazılır (kalıcı) — admin paneli buradan okur.
# TANIMSIZSA: yerel .veri/siparisler.json dosyası kullanılır. Vercel gibi
#   serverless ortamda dosya sistemi GEÇİCİDİR — orada mutlaka tanımlanmalı.
# Vercel Postgres / Neon / Supabase bağlantı dizesi:
DATABASE_URL=

# Yerel dosya deposunun klasörü (varsayılan: .veri)
VERI_KLASORU=

# --- Admin paneli (/admin) -------------------------------------------------
# Yönetici e-postaları, virgülle ayrılmış. Boşsa varsayılan liste kullanılır.
ADMIN_EMAILS=ertugrultoraman@hotmail.com

# ZORUNLU: tanımlanmazsa /admin tamamen kapalıdır (varsayılan parola YOK).
# Güçlü bir parola üretin: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# Opsiyonel: oturum çerezi imza anahtarı (en az 16 karakter).
# Verilmezse ADMIN_PASSWORD'den türetilir — parola değişince oturumlar düşer.
ADMIN_SESSION_SECRET=

# --- iyzico (kredi/banka kartı ödemesi) ------------------------------------
# Anahtarlar tanımlı DEĞİLSE kart ödemesi arayüzde hiç görünmez, yalnızca
# havale/EFT sunulur. Sandbox: https://sandbox-api.iyzipay.com
# Canlı:   https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com

# iyzico alıcı kaydında kimlik no zorunlu. Yemek siparişinde TCKN toplamamak
# için varsayılan kullanılır; hesabınız gerçek TCKN istiyorsa burayı doldurun.
IYZICO_IDENTITY_NUMBER=

# --- Görsel depolama: Vercel Blob -----------------------------------------
# Vercel Dashboard → Storage → Blob → Connect. Token otomatik enjekte edilir;
# lokalde `vercel env pull` ile alabilir veya buraya elle yazabilirsin.
BLOB_READ_WRITE_TOKEN=

# --- AI görsel üretimi ----------------------------------------------------
# Hangi sağlayıcı kullanılacak: openai | google | replicate
IMAGE_PROVIDER=openai

# OpenAI (gpt-image-1)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google (Imagen / Gemini image)
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

# Replicate (Flux vb.)
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
