# ---------------------------------------------------------------------------
# Ne Yersin? — ortam değişkenleri
# Lokal: bu dosyayı `.env.local` olarak kopyala ve doldur.
# Vercel: Project Settings → Environment Variables (Production/Preview/Development)
# Hiçbiri NEXT_PUBLIC_ değil — tamamı yalnızca sunucu tarafında kullanılır.
# ---------------------------------------------------------------------------

# Sitenin kanonik adresi (sitemap, robots, OG etiketleri için).
# Vercel'de otomatik gelen VERCEL_PROJECT_PRODUCTION_URL fallback olarak kullanılır.
NEXT_PUBLIC_SITE_URL=https://neyersin.com

# --- Sipariş ve başvuru kaydı ----------------------------------------------
# Oluşan sipariş bu adrese POST edilir (n8n / Zapier / Apps Script / kendi API'niz).
# Tanımlı değilse sipariş yalnızca sunucu günlüğüne yazılır (Vercel → Logs).
# NOT: Kalıcı bir veritabanı yerine geçmez — bkz. README "Siparişler nereye kaydediliyor?"
SIPARIS_WEBHOOK_URL=

# İletişim/başvuru formu hedefi. Boşsa SIPARIS_WEBHOOK_URL kullanılır.
BASVURU_WEBHOOK_URL=

# --- Sipariş veritabanı ----------------------------------------------------
# TANIMLIYSA: siparişler Postgres'e yazılır (kalıcı) — admin paneli buradan okur.
# TANIMSIZSA: yerel .veri/siparisler.json dosyası kullanılır. Vercel gibi
#   serverless ortamda dosya sistemi GEÇİCİDİR — orada mutlaka tanımlanmalı.
# Vercel Postgres / Neon / Supabase bağlantı dizesi:
DATABASE_URL=

# Yerel dosya deposunun klasörü (varsayılan: .veri)
VERI_KLASORU=

# --- Admin paneli (/admin) -------------------------------------------------
# Yönetici e-postaları, virgülle ayrılmış. Boşsa varsayılan liste kullanılır.
ADMIN_EMAILS=ertugrultoraman@hotmail.com

# ZORUNLU: tanımlanmazsa /admin tamamen kapalıdır (varsayılan parola YOK).
# Güçlü bir parola üretin: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD=

# Opsiyonel: oturum çerezi imza anahtarı (en az 16 karakter).
# Verilmezse ADMIN_PASSWORD'den türetilir — parola değişince oturumlar düşer.
ADMIN_SESSION_SECRET=

# --- iyzico (kredi/banka kartı ödemesi) ------------------------------------
# Anahtarlar tanımlı DEĞİLSE kart ödemesi arayüzde hiç görünmez, yalnızca
# havale/EFT sunulur. Sandbox: https://sandbox-api.iyzipay.com
# Canlı:   https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_URI=https://sandbox-api.iyzipay.com

# iyzico alıcı kaydında kimlik no zorunlu. Yemek siparişinde TCKN toplamamak
# için varsayılan kullanılır; hesabınız gerçek TCKN istiyorsa burayı doldurun.
IYZICO_IDENTITY_NUMBER=

# --- Görsel depolama: Vercel Blob -----------------------------------------
# Vercel Dashboard → Storage → Blob → Connect. Token otomatik enjekte edilir;
# lokalde `vercel env pull` ile alabilir veya buraya elle yazabilirsin.
BLOB_READ_WRITE_TOKEN=

# --- AI görsel üretimi ----------------------------------------------------
# Hangi sağlayıcı kullanılacak: openai | google | replicate | pollinations
IMAGE_PROVIDER=pollinations

# Pollinations (Flux) — anahtar gerektirmez, ücretsizdir. Ücretli bir sağlayıcı
# hazır olana kadar köprü olarak kullanılır. Anonim kullanım hız sınırlıdır, bu
# yüzden `npm run images:generate -- --concurrency=2` gibi düşük paralellik iyidir.
# Opsiyonel: pollinations.ai hesabı varsa POLLINATIONS_TOKEN ile limit yükselir.
POLLINATIONS_MODEL=flux
POLLINATIONS_TOKEN=

# OpenAI (gpt-image-1)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Google (Gemini image / Imagen) — fotogerçekçi sonuç için tercih edilen sağlayıcı.
#   gemini-3-pro-image        → "Nano Banana Pro", en iyi kalite (ÖNERİLEN)
#   gemini-2.5-flash-image    → "Nano Banana", daha ucuz ve hızlı
#   imagen-4.0-generate-001   → Imagen 4
# NOT: Görsel modellerinin hepsi FATURALANDIRMA ister. Ücretsiz katmanda kota 0'dır
# ve istek "429 ... limit: 0" ile döner. Proje engellenmişse hata 403 olur:
# "Your project has been denied access" — bu durumda yeni bir Google Cloud projesi
# açıp yeni anahtar üretmek gerekir.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3-pro-image

# Replicate (Flux vb.)
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# --- E-posta gönderimi (doğrulama kodu / parola sıfırlama) -------------------
# Google Workspace (neyersin.net) SMTP'si. SMTP_PAROLA normal hesap parolası
# DEĞİL, Google hesabından üretilen "uygulama şifresi"dir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_KULLANICI=merhaba@neyersin.net
SMTP_PAROLA=
SMTP_GONDEREN=merhaba@neyersin.net

# --- Google ile giriş ---------------------------------------------------------
# Google Cloud Console → API'ler ve Hizmetler → Kimlik Bilgileri →
# "OAuth istemci kimliği oluştur" → Uygulama türü: Web uygulaması
#
# Yetkili yönlendirme URI'leri olarak ŞU İKİSİNİ ekle (birebir, sonda / yok):
#   http://localhost:3000/api/oturum/google/callback
#   https://neyersin.net/api/oturum/google/callback
#
# Not: Google, neyersin.local gibi gerçek olmayan alan adlarını kabul etmez;
# yerel test bu yüzden localhost:3000 üzerinden yapılır.
#
# Bu iki değer tanımlı değilse Google girişi KAPALIDIR ve düğme hiç görünmez.
GOOGLE_ISTEMCI_ID=
GOOGLE_ISTEMCI_SIRRI=
# İsteğe bağlı: geri dönüş adresini sabitler. Boşsa istekten türetilir.
GOOGLE_YONLENDIRME=

# --- Deneme hesapları -------------------------------------------------------
# `npm run hesap:test` bu parolayı ornek@, ornek1@, ornek2@, ornek3@gmail.com
# hesaplarına yazar (rollerine dokunmaz). Gerçek hesaplara ASLA dokunmaz.
# Tanımsızsa betik hiçbir şey yapmadan çıkar — gömülü varsayılan yok, olsaydı
# canlıdaki deneme hesaplarının parolası herkesçe bilinir olurdu.
TEST_PAROLA=

# --- Otomatik çeviri ---------------------------------------------------------
# Anket sorusu/şıkları veritabanında tutulduğu için sözlükte yer alamıyor.
# Yönetici İngilizce alanı boş bırakırsa GOOGLE_API_KEY ile otomatik çevrilir.
# Anahtar yoksa ya da kota biterse alan boş kalır ve gösterimde Türkçesi çıkar.
# Model takma adla sabitlendi; istenirse buradan değiştirilir.
GOOGLE_CEVIRI_MODELI=gemini-flash-lite-latest
